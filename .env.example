# Optional local runtime overrides. Do not place upstream credentials here.
PORT=8787
STARCAT_ADMIN_DATA_DIR=/absolute/path/to/private/starcat-admin-console-data
STARCAT_SUPPORTS_DIR=/absolute/path/to/Starcat/supports
STARCAT_DATA_PLATFORM_DATABASE_URL=postgres://starcat:starcat@127.0.0.1:55432/starcat_data_platform
STARCAT_TRAINER_ROOT=../starcat-recsys-trainer
# Raw 工作区只由 BFF 读取，不会返回给浏览器或写入 PostgreSQL Catalog。
STARCAT_WATCH_WORKSPACE=/Volumes/T0/Starcat/bigquery/watch-events-2016-2026
STARCAT_PUSH_WORKSPACE=/Volumes/T0/Starcat/bigquery/push-events-2016-2026
STARCAT_BQ_BILLING_PROJECT=
STARCAT_BQ_LOCATION=US
